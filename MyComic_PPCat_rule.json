[
    {
        "bookSourceName": "MyComic",
        "bookSourceUrl": "https://mycomic.com",
        "bookSourceType": 1,
        "enable": true,
        "httpUserAgent": "Mozilla/5.0 (Windows NT 10.0; Win64; x64) Chrome/150",
        "header": {
            "Referer": "https://mycomic.com/"
        },
        "searchUrl": "https://mycomic.com/comics?q={{key}}",
        "ruleSearch": {
            "itemList": "a[href*='/comics/']",
            "itemName": "img@alt",
            "itemUrl": "a@href",
            "itemCover": "img@src",
            "itemAuthor": ""
        },
        "ruleBookInfo": {
            "name": "h1",
            "cover": "meta[property='og:image']@content",
            "author": "",
            "intro": ""
        },
        "ruleChapter": {
            "chapterList": "a[href*='/chapters/']",
            "chapterName": "text()",
            "chapterUrl": "@href"
        },
        "ruleContent": {
            "imageList": "img.page@src"
        }
    }
]